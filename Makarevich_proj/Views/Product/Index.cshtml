@* @model IEnumerable<Makarevich_sol_Domain.Entities.Doctor> *@
@* @model IEnumerable<Doctor> *@
@using Makarevich_sol_Domain.Models
@model ListModel<Doctor>

@{
	ViewData["Title"] = "Index";

	//Адрес текущей страницы:
	var request = ViewContext.HttpContext.Request;
	var returnUrl = request.Path + request.QueryString.ToUriComponent();
	var clinics = ViewData["clinics"] as IEnumerable<Clinic>;

	string? clinic = request.RouteValues["clinic"]?.ToString();
	int prev = Model.CurrentPage == 1
	? 1
	: Model.CurrentPage - 1;
	int next = Model.CurrentPage == Model.TotalPages
	? Model.TotalPages
	: Model.CurrentPage + 1;

}


<h1>Врачи</h1>
<div class="row">

	<!-- выбор категории -->
	<div class="col-2 border-2">
		<ul class="nav ">
			<li class="nav-item dropdown">
				<a class="nav-link dropdown-toggle"
				   data-bs-toggle="dropdown"
				   href="#"
				   role="button"
				   aria-expanded="false">
					@ViewData["currentClinic"]
				</a>
				<ul class="dropdown-menu">
					<li>
						<a class="dropdown-item"
						   asp-controller="product"
						   asp-route-clinic=@null>Все</a>
					</li>
					@foreach (var item in clinics)
					{
						<li>
							<a class="dropdown-item"
							   asp-controller="product"
							   asp-route-clinic="@item.IdNormalizedName">
								@item.Name
							</a>
						</li>
					}
				</ul>
			</li>
		</ul>
	</div><!-- выбор категории -->


	@if (Model !=null)
	{

	<div class="card-group">


		@foreach (var item in Model.Items)
		{
			<div class="col-4 p-4">
				<div class="card border-dark m-2 text-center">
					<img class="card-img-top" src="@item.Image" alt="No image available" />
					<div class="card-body">
						<h5 class="card-title ">@item.Surname @item.Name</h5>
						<p class="card-text">@item.Specialization</p>
						<p class="card-text">
							@item.IdClinic
						</p>
						<h5><span class="badge bg-secondary">Количество пациентов: @item.AmountOfPatients</span></h5>
					</div><!-- card-body -->
					<div class="card-footer text-center">
						<a class="btn btn-outline-primary"
						   asp-action="add" asp-controller="cart" asp-route-id="@item.Id"
						   asp-route-returnurl="@returnUrl">
							Записаться на приём <i class="fa-solid fa-book-open"></i>
						</a>
					</div><!-- card-footer -->
				</div><!-- card -->
			</div>
			<!-- col -->
		}

	</div>
	}

	<pager current-page="@Model.CurrentPage"
		   total-pages="@Model.TotalPages"

		   clinic="@clinic">
	</pager>

	@* 	<!-- Pager -->
	<div class="row">
		<nav aria-label="Pages">
			<ul class="pagination">
				<li class="page-item @(prev == Model.CurrentPage ? "disabled" : "")">
					<a class="page-link "
					   asp-controller="Product"
					   asp-action="Index"
					   asp-route-pageno="@prev"
					   asp-route-category="@clinic" aria-label="Previous">
						<span aria-hidden="true">&laquo;</span>
					</a>
				</li>
				@for (int i = 1; i <= Model.TotalPages; i++)
				{
					<li class="page-item @(i == Model.CurrentPage ? "active" : "")">
						<a class="page-link"
						   asp-controller="Product"
						   asp-action="Index"
						   asp-route-pageno="@i"
						   asp-route-clinic="@clinic">
							@i
						</a>
					</li>
				}
				<li class="page-item @(next == Model.CurrentPage ? "disabled" : "")">
					<a class="page-link"
					   asp-action="Index"
					   asp-route-pageno="@next"
					   asp-route-clinic="@clinic" aria-label="Next">
						<span aria-hidden="true">&raquo;</span>
					</a>
				</li>
			</ul>
		</nav>
	</div> <!-- Pager --> *@
	<h2 class="text-warning">@ViewData["Error"]</h2>

</div>
