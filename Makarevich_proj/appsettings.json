    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=Makarevich_proj;Trusted_Connection=True;MultipleActiveResultSets=true"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ItemsPerPage": 3
}


/*    "DefaultConnection" — имя соединения, которое ссылается на строку подключения к базе данных.
    Значение строки подключения:
        Server=(localdb)\\mssqllocaldb; — использует локальный экземпляр LocalDB SQL Server.
        Database=aspnet-Makarevich_proj-8ba8bf60-a09a-455f-ad65-c77720e4134a — название базы данных (обычно автоматически сгенерировано для проекта/учетной записи).
        Trusted_Connection=True; — использует текущие учетные данные Windows для аутентификации.
        MultipleActiveResultSets=true — разрешает выполнение нескольких активных наборов результатов одновременно.

      Настройки для уровня логирования:

    Default: показывает логирование уровня «Information» — достаточно информативно, включая обычные события.
    Microsoft.AspNetCore: уровень «Warning» — т.к. здесь логируются только предупреждения и ошибки, чтобы избежать излишнего шума.

              "*": разрешает принимать запросы с любых доменов (хостов).
В продакшене обычно указывают конкретные домены для повышения безопасности

*/