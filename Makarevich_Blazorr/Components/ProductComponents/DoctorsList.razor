@using Makarevich_Blazorr.Services
@using Makarevich_sol_Domain.Entities
@implements IDisposable
@* @rendermode InteractiveServer *@


<h3>Список врачей</h3>


@if (ProductService.Products != null && ProductService.Products.Count() != 0)

{
	<table class="table table-striped">
		<thead>
		<th>Название</th>
		<th></th>
		@foreach (var item in ProductService.Products)
		{
			<tr>
				<td>@item.Name</td>
				<td>
					<button class="btn btn-outline-dark"
							@onclick="@(() => OnDishSelected(item.Id))">
						Подробно
					</button>

				</td>
			</tr>


		}
		</thead>
	</table>
}



@code {

	[CascadingParameter]
	public IProdService<Doctor> ProductService { get; set; }

	[Parameter]
	public EventCallback<int> DishSelected { get; set; }

	protected override async Task OnInitializedAsync()
	{
		ProductService.ListChanged += StateHasChanged;
	}
	public async void OnDishSelected(int id)
	{
		await DishSelected.InvokeAsync(id);
	}

	public void Dispose()
	{
		ProductService.ListChanged -= StateHasChanged;
	}

}
